generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  password     String?
  name         String   @unique
  refreshToken String?
  accessToken  String?                                           
  Token        String
  twoFactorAuthenticationSecret String? 
  isTwoFactorAuthenticationEnabled Boolean? @default(false)
 
  createdAt    DateTime @default(now())

  massages Message[] 
}

model Message {
  id        String      @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  
  roomId    String
  room      ChatRoom     @relation(fields: [roomId], references: [id])
	@@map("Chat")
}

model ChatRoom  { 
  id        String      @id @default(uuid())
  name String @map("roomeID")
  createdAt DateTime? @default(now())

   messages Message[] 
}
