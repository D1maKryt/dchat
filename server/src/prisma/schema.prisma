generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  password     String?
  name         String   @unique
  refreshToken String?
  accessToken  String?                                           
  Token        String
  twoFactorAuthenticationSecret String? 
  isTwoFactorAuthenticationEnabled Boolean? @default(false)
 
  createdAt    DateTime @default(now())

  massages Message[] 
    roles UsersOnRoles[] 
}

model Role {
  id String @id @default(uuid())
  name String @unique
  createdAt DateTime @default(now())

  users UsersOnRoles[]
}

model Message {
  id        String      @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  
  roomId    String
  room      ChatRoom     @relation(fields: [roomId], references: [id])
	@@map("Chat")
}

model ChatRoom  { 
  id        String      @id @default(uuid())
  name String @map("roomeID")
  createdAt DateTime? @default(now())

   messages Message[] 
}


model UsersOnRoles {
  user       User     @relation(fields: [userId], references: [id])
  userId     String      // Внешний ключ на User
  role       Role     @relation(fields: [roleId], references: [id])
  roleId     String      // Внешний ключ на Role
  assignedAt DateTime @default(now()) // Доп. поле (например, дата назначения)

  @@id([userId, roleId]) // Составной ключ, чтобы нельзя было дать одну роль дважды
}
